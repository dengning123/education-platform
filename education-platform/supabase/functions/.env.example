# Exact comma-separated browser origins, or "none" while no browser UI is deployed.
FIT_EDGE_ALLOWED_ORIGINS=none

# Release identity must be set to the reviewed release and immutable source build.
FIT_EDGE_RELEASE_ID=phase4a1-local
FIT_EDGE_BUILD_HASH=uncommitted

# Optional bounded override; the default is 65536 bytes.
# FIT_EDGE_MAX_BODY_BYTES=65536
