# Exact comma-separated browser origins, or "none" while no browser UI is deployed.
FIT_EDGE_ALLOWED_ORIGINS=none

# Fit semantic release and the exact deployed source build are independent identities.
FIT_EDGE_SEMANTIC_RELEASE=fit-v0.1
FIT_EDGE_DEPLOYED_BUILD=uncommitted

# The code-owned shared boundary identity is fit-edge-http-v1.

# Optional bounded override; the default is 65536 bytes.
# FIT_EDGE_MAX_BODY_BYTES=65536

# Cooperative whole-request and per-dependency deadlines, in milliseconds.
# FIT_EDGE_REQUEST_DEADLINE_MS=50000
# FIT_EDGE_DEPENDENCY_DEADLINE_MS=10000
